# ---- Admin login (required; the app refuses admin routes without a JWT_SECRET) ----
ADMIN_USERNAME="your_admin_username"
ADMIN_PASSWORD="a_long_random_password"
JWT_SECRET="at_least_32_random_characters"

# ---- Site ----
NEXT_PUBLIC_SITE_URL="https://www.mcprimedigital.com"

# ---- Cloudflare R2 (video storage; S3-compatible) ----
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="mcprime-media"
# Public base URL of the bucket (custom domain such as https://media.mcprimedigital.com
# or the bucket's https://pub-xxxx.r2.dev URL). When set, films are served from the
# Cloudflare CDN with long-lived URLs. When empty, the API falls back to 2-hour
# presigned URLs that bypass the CDN.
R2_PUBLIC_BASE_URL=""

# ---- Mailgun (contact + careers forms) ----
MAILGUN_KEY="key-xxxxxxxxxxxxxxxx"
MAILGUN_DOMAIN="mg.mcprimedigital.com"
CONTACT_EMAIL_DESTINATION="hello@mcprimedigital.com"
